# Version control
.git

# IDE and editor files
.idea
.vscode
.DS_Store

# Build caches
.eslintcache

# Build outputs
build/
dist/

# Dependencies
node_modules/

# Dockerfile is read by the docker client from the workspace root — no
# workflow passes --file. Excluding it from the build context only trims the
# context transfer.
Dockerfile*
*.log

# Secrets / local env — never bake into the image via `COPY . /app`
.env
.env.*

# GitHub workflows
.github/

# SDD specs
.sdd/

# Test coverage
coverage/

# Local dev SSL certificates
cert/
